# Portkey Gateway Configuration
# Get your API key from: https://app.portkey.ai/
PORTKEY_API_KEY=your_portkey_api_key_here

# Portkey Virtual Key (for single-provider routing)
PORTKEY_VIRTUAL_KEY=your_virtual_key_here

# Portkey Config ID (for multi-provider fallback routing: Groq -> Mistral)
PORTKEY_CONFIG_ID=pc-your-fallback-config-slug

# Primary Model
GROQ_MODEL=openai/gpt-oss-120b